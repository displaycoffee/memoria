	"version": "1.0.0",
	"description": "Custom WordPress template.",
	"main": "bundle.js",
	"type": "module",
	"keywords": [],
	"author": "displaycoffee",
	"license": "ISC",
	"homepage": "https://github.com/displaycoffee/memoria#readme",
