---
/* Styles */
import './styles/container.scss';

// /* Packages */
// import { useRef } from 'react';
// import { Link, useLocation } from '@tanstack/react-router';

/* Scripts */
import type { ContainerProps } from './scripts/container-types';
// import { useRespond } from '@displaycoffee/scripts/hooks';
// import { useAvailableMinHeight, useBodyClass } from '@displaycoffee/scripts/hooks-tanstack';
import { context } from '@/context/scripts/context';
// import { navigationHeader } from '@/components/navigation/scripts/navigation';

/* Components */
// import { ErrorBoundary } from '@/components/error-boundary/ErrorBoundary';
// import { Navigation } from '@/components/navigation/Navigation';
// import { ButtonScroll } from '@/components/forms/Forms';
// import { Slideout } from '@/components/slideout/Slideout';
import Head from '@/layout/head/Head.astro';
import Header from '@/layout/header/Header.astro';
import Content from '@/layout/content/Content.astro';
import Sidebar from '@/layout/sidebar/Sidebar.astro';
// import { Footer } from '@/layout/footer/Footer';
// import { Portal } from '@/targets/portal/Portal';

/* Define prop types */
type Props = ContainerProps;

/* Props */
const { hideSidebar = false, title } = Astro.props;

/* Get theme options */
const options = await context.wp.themeOptions.themeOptions();

/* Create body class */
const bodyClass = title ? context.utils.handleize(title) : 'index';

/* Slideout options */
// const slideoutOptions = {
// 	id: 'menu',
// 	label: 'Menu',
// };
---

<!doctype html>
<html lang="en">
	<Head title={title} />
	<body class={`scrollbar page-${bodyClass}`}>
		<div class="container">
			<a href="#main-content" class="skip-link sr-only no-decoration">
				Skip to main content
			</a>

			<Header options={options} />

			<!-- <Header />
	
			{isDesktop ? (
				<Navigation data={navigationHeader} label={'Header Navigation'} />
			) : (
				<Slideout options={slideoutOptions}>
					<Navigation data={navigationHeader} disableTransition={true} label={'Mobile Navigation'} />
				</Slideout>
			)} -->

			<main id="main-content" class="main">
				<div class="main-layout flex-wrap">
					<Content>
						<slot />
					</Content>

					{!hideSidebar && <Sidebar slug={options?.sidebar?.slug ?? ''} />}
				</div>
			</main>

			<!-- <Footer />
	
			<ButtonScroll target={'#index'} label={'Scroll to top'} /> -->
		</div>

		<script>
			import { container } from './scripts/container';
			container.init();
		</script>
	</body>
</html>
