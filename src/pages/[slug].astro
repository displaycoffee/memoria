---
/* Scripts */
import { context } from '@/context/scripts/context.ts';

/* Components */
import Container from '../layout/container/Container.astro';
import { Page } from '@/wp/page/Page';

/* Get pages */
export const getStaticPaths = async () => {
	const themeOptions = await context.wp.themeOptions.themeOptions();
	const sidebarSlug = themeOptions?.sidebar?.slug;
	const pages = sidebarSlug ? await context.wp.page.all([sidebarSlug]) : await context.wp.page.all();
	return pages.map((page) => ({
		params: { slug: page.slug },
		props: { page },
	}));
};

/* Define prop types */
import type { InferGetStaticPropsType } from 'astro';
type Props = InferGetStaticPropsType<typeof getStaticPaths>;

/* Props */
const { page } = Astro.props;

/* Page title */
const title = page.title;
---

<Container title={title} hideSidebar={page.hideSidebar}>
	<Page page={page} />
</Container>
