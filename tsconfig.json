{
	"compilerOptions": {
		"outDir": "./dist",
		"rootDir": "./src",
		"allowJs": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"jsx": "react-jsx",
		"module": "esnext",
		"moduleResolution": "bundler",
		"noFallthroughCasesInSwitch": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"strict": true,
		"target": "ES2022",
		"types": ["vite/client", "jquery"]
	},
	"include": ["src"],
	"exclude": ["dist"]
}
